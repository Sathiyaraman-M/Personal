---
import CallToAction from "./CallToAction.astro";
import Icon from "./Icon.astro";
---

<aside>
    <div class="contact-inner">
        <div class="contact-copy">
            <h2>If you’d like to talk about engineering, platforms, or an interesting problem, say hello.</h2>
        </div>
        <CallToAction href="mailto:me@sathiyaraman-m.com">
            Get in touch
            <Icon icon="paper-plane-tilt" size="1.2em" />
        </CallToAction>
    </div>
</aside>

<style>
    aside {
        position: relative;
        overflow: hidden;
        border-block: 1px solid var(--rule-strong);
        background: linear-gradient(120deg, var(--surface-muted) 0%, var(--surface-raised) 100%);
    }
    aside::before {
        content: "";
        position: absolute;
        inset: 0;
        opacity: 0.45;
        background-image: linear-gradient(var(--rule) 1px, transparent 1px), linear-gradient(90deg, var(--rule) 1px, transparent 1px);
        background-size: 3rem 3rem;
        mask-image: linear-gradient(90deg, black, transparent 72%);
        pointer-events: none;
    }
    aside::after {
        content: "↗";
        position: absolute;
        right: 7vw;
        bottom: -3.5rem;
        color: color-mix(in srgb, var(--accent) 18%, transparent);
        font-family: var(--font-mono);
        font-size: 14rem;
        line-height: 1;
        pointer-events: none;
    }
    .contact-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-8);
        width: min(100% - 2rem, 72rem);
        margin-inline: auto;
        padding-block: var(--space-16);
        border-left: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    }
    .contact-copy {
        position: relative;
        padding-left: var(--space-6);
    }
    .contact-copy::before {
        content: "";
        position: absolute;
        top: 0.25rem;
        bottom: 0.25rem;
        left: 0;
        width: 3px;
        background: var(--accent);
    }
    h2 {
        font-size: var(--text-xl);
        text-align: left;
        max-width: 25ch;
    }

    :global(.contact-inner > a) {
        width: fit-content;
    }

    @media (min-width: 50em) {
        .contact-inner {
            width: min(100% - 5rem, 72rem);
            min-height: 14rem;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            padding-block: var(--space-8) var(--space-6);
        }

        h2 {
            font-size: var(--text-xl);
            text-align: left;
        }
    }
</style>
