---
import CallToAction from "./CallToAction.astro";
import Icon from "./Icon.astro";
---

<aside>
    <h2>If you’d like to talk about engineering, platforms, or an interesting problem, say hello.</h2>
    <CallToAction href="mailto:me@sathiyaraman-m.com">
        Get in touch
        <Icon icon="paper-plane-tilt" size="1.2em" />
    </CallToAction>
</aside>

<style>
    aside {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-8);
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        padding: var(--space-16) 1rem;
        background-color: var(--surface-muted);
    }

    h2 {
        font-size: var(--text-xl);
        text-align: center;
        max-width: 25ch;
    }

    @media (min-width: 50em) {
        aside {
            padding: var(--space-16) max(2rem, calc((100vw - 72rem) / 2));
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        h2 {
            font-size: var(--text-xl);
            text-align: left;
        }
    }
</style>
