---
interface Props {
	href: string;
	target?: string;
}

const { href, target } = Astro.props;
---

<a href={href} target={target != null ? target : "_self"}><slot /></a>

<style>
	a {
		position: relative;
		display: flex;
		place-content: center;
		text-align: center;
		padding: 0.75rem 1rem;
		gap: 0.8em;
		color: var(--accent-text);
		text-decoration: none;
		line-height: 1.1;
		border: 1px solid var(--accent);
		border-radius: 2px;
		background: var(--accent);
		transition: background-color var(--theme-transition), transform var(--theme-transition);
		white-space: nowrap;
	}

	a:active {
		transform: translateY(2px);
	}

	@media (min-width: 20em) {
			a { font-size: var(--text-base); }
	}

	a:hover, a:focus { background: var(--accent-strong); }

	@media (min-width: 50em) {
		a { padding: 0.875rem 1.25rem; font-size: var(--text-base); }
	}
</style>
