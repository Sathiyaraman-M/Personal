---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import CallToAction from '../components/CallToAction.astro';
---

<BaseLayout title="About Sathiyaraman M | Solution Consultant" description="Learn about Sathiyaraman M, a Solution Consultant at Sahaj Software working across consulting, platform engineering, and software development.">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				 tagline="I work across solution consulting, platform engineering, and hands-on software development."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Sathiyaraman M & Team at SIH 2022"
				/>
				<span>Participated in Grand Finale of Smart India Hackathon 2022, organized by Ministry of Education, Govt. of India.</span>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I am a Solution Consultant at Sahaj Software, where I work across consulting and engineering. Over the past two years, my work has included technical decision-making, platform engineering, and hands-on implementation of software systems.
					</p>
					<br />
					<p>
						My current work is primarily focused on the JVM ecosystem, platform engineering, and the TypeScript ecosystem, including Node.js and React. I also retain strong, hands-on expertise in .NET, C#, ASP.NET Core, Blazor, and SQL Server—technical strengths that continue to inform how I design and build solutions.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>
						I hold a Bachelor's degree in Computer Science and Engineering from R.M.K. Engineering College, Tamil Nadu, India. My academic background gave me the foundation for the software engineering and systems work I do today.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>
						My proficiency in .NET, Blazor, Angular, Flutter and SQL Server is complemented by a strong foundation in front-end and back-end development, including HTML, CSS, JavaScript, TypeScript and SQL. I am skilled in developing responsive layouts and user interfaces, as well as implementing back-end functionalities such as RESTful APIs and databases. Additionally, I possess strong problem-solving skills and an analytical mindset, allowing me to tackle complex challenges and deliver high-quality solutions.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Resume</h2>
				<div class="content">
					<p>
						You can download my resume in PDF format by clicking the button below.
					</p>
					<br />
					<div class="download-resume">
						<CallToAction href="/Sathiyaraman M's Resume.pdf" target="_blank">Download Resume</CallToAction>
					</div>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}

	.download-resume {
		display: flex;
		width: 50%;
		justify-content: start;
		align-items: center;
		text-decoration: none;
	}

	.download-resume :global(a) {
		text-decoration: none;
	}

	@media (max-width: 50em) {
		.download-resume {
			width: 100%;
		}
	}
</style>
