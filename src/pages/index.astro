---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
    title="Sathiyaraman M | Solution Consultant & Engineer"
    description="Sathiyaraman M is a Solution Consultant and Engineer at Sahaj Software, working across technical consulting, software engineering, and platform engineering."
>
    <div class="page stack">
        <main id="home" class="wrapper stack page-content">
            <header class="hero-section reveal">
                <Hero
                    title="Hello, I’m Sathiyaraman."
                    tagline="I’m a Solution Consultant and Engineer at Sahaj Software. I work across consulting, software engineering, and platform engineering to make complex problems easier to solve."
                    align="start"
                >
                    <div class="hero-actions">
                        <CallToAction href="#about">
                            A little about me <Icon icon="arrow-right" size="1.1em" />
                        </CallToAction>
                    </div>
                </Hero>
                <div class="portrait-frame">
                    <img
                        class="hero-image"
                        alt="Sathiyaraman M"
                        width="480"
                        height="620"
                        src="/assets/portrait.png"
                    />
                </div>
            </header>

            <section class="content-section intro reveal" id="about">
                <div class="section-label">01 / About</div>
                <h2>
                    I started by following code examples. Then I started
                    asking what code could do for someone.
                </h2>
                <div class="intro-copy">
                    <p>
                        Back in school, I spent time following random C#
                        tutorials in Visual Studio, trying to reproduce what I
                        saw on screen. It was simple, sometimes messy, and
                        completely absorbing. Those small acts of replication
                        were my first experience of the joy of building
                        something with code.
                    </p>
                    <p>
                        Over time, I became more interested in programming itself:
                        how to turn an abstract idea into something useful for
                        a real person, and how to do that with a little more
                        elegance each time. That is still the thread connecting
                        the work I do today.
                    </p>
                </div>
            </section>

            <section
                class="content-section timeline-section reveal"
                id="journey"
                aria-labelledby="journey-title"
            >
                <div class="section-label">02 / Journey</div>
                <div
                    class="section-heading"
                >
                    <h2 id="journey-title">
                        From building software to helping shape how it gets
                        built.
                    </h2>
                </div>
                <ol class="timeline">
                    <li>
                        <span class="timeline-marker">01</span>
                        <div>
                            <h3>My first stack</h3>
                            <p>
                                I began with .NET, learning how to turn a blank
                                project into something that actually worked.
                                That early habit of building is still part of
                                how I approach a new problem.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="timeline-marker">02</span>
                        <div>
                            <h3>Learning by making</h3>
                            <p>
                                Projects, hackathons, and hands-on
                                experimentation taught me to connect technical
                                decisions with the people and problems behind
                                them.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="timeline-marker">03</span>
                        <div>
                            <h3>Consulting and engineering at Sahaj</h3>
                            <p>
                                For the past two years, I’ve worked across
                                technical consulting, decision-making,
                                implementation, and platform engineering.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="timeline-marker">04</span>
                        <div>
                            <h3>What I’m focused on now</h3>
                            <p>
                                At work, I’m using Kotlin, Java and React/TypeScript.
                                Outside work, I’m exploring Rust and its ecosystem.
                                In mean time, I am also working on few developer-oriented 
                                toolings to make the developer experiences (DX) much better.
                            </p>
                        </div>
                    </li>
                </ol>
            </section>

            <section
                class="content-section perspective reveal"
                id="approach"
                aria-labelledby="perspective-title"
            >
                <div class="section-label">03 / Approach</div>
                <h2
                    id="perspective-title"
                >
                    A few wild experiments, built from tools I already know.
                </h2>
                <div class="projects">
                    <article>
                        <div class="project-meta"><span>01</span><span>Still in progress</span></div>
                        <h3>Tree-sitter grammar for Razor</h3>
                        <p>I started this after working on my own fork of Zed’s C# extension. It works, though it’s rough, and has already made my Blazor projects more usable - especially since Zed has no Razor tooling. That led me to Tree-sitter, a beast of a tool, and eventually to writing a grammar of my own.</p>
                        <a class="text-link" href="https://github.com/Sathiyaraman-M/tree-sitter-razor" target="_blank">View on GitHub <Icon icon="arrow-up-right" size="1em" /></a>
                    </article>
                    <article>
                        <div class="project-meta"><span>02</span><span>Proof of concept</span></div>
                        <h3>Native AppKit with Blazor and C#</h3>
                        <p>I’m building a framework that lets you write native macOS AppKit UI with Blazor and C# - not HTML. It’s an experiment in bringing Blazor’s component model to native desktop interfaces.</p>
                        <a class="text-link" href="https://github.com/Sathiyaraman-M/BlazorAppKit" target="_blank">View on GitHub <Icon icon="arrow-up-right" size="1em" /></a>
                    </article>
                    <article>
                        <div class="project-meta"><span>03</span><span>Built in C#</span></div>
                        <h3>An OpenFGA Kubernetes Operator</h3>
                        <p>At work, I started by managing OpenFGA resources manually in GitHub Actions, then moved to the official Terraform provider to automate much of it. My interest in Kubernetes and OpenFGA eventually turned that experience into this small experiment: an operator for managing stores, models, and tuples.</p>
                        <a class="text-link" href="https://github.com/Sathiyaraman-M/OpenFGA-Operator" target="_blank">View on GitHub <Icon icon="arrow-up-right" size="1em" /></a>
                    </article>
                </div>
            </section>

            <section class="content-section closing-note reveal">
                <div class="section-label">04 / Elsewhere</div>
                <p>
                    There is more to me than a list of technologies. I write
                    occasionally, keep learning, and make things when an idea is
                    interesting enough to follow.
                </p>
                <a
                    class="text-link"
                    href="https://blogs.sathiyaraman-m.com/"
                    target="_blank"
                    >Read what I write <Icon
                        icon="arrow-right"
                        size="1em"
                    />
                    </a>
            </section>
        </main>
        <div id="contact">
            <ContactCTA />
        </div>
    </div>
</BaseLayout>

<style>
    .page-content {
        gap: var(--space-24);
        padding-block: var(--space-16) var(--space-24);
    }
    .hero-section {
        display: grid;
        gap: var(--space-12);
        align-items: center;
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-6);
        margin-top: var(--space-8);
    }
    .portrait-frame {
        position: relative;
        width: min(100%, 25rem);
        border: 1px solid var(--rule-strong);
        background: var(--surface-raised);
    }
    .portrait-frame::after {
        content: "";
        position: absolute;
        inset: var(--space-3) calc(var(--space-3) * -1)
            calc(var(--space-3) * -1) var(--space-3);
        z-index: -1;
        border: 2px solid var(--accent);
        transition: transform 300ms ease;
    }
    .portrait-frame:hover::after {
        transform: translate(6px, 6px);
    }
    .hero-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        object-position: top;
        filter: saturate(0.85);
        transition:
            filter 300ms ease,
            transform 300ms ease;
    }
    .portrait-frame:hover .hero-image {
        filter: saturate(1);
        transform: translate(-4px, -4px);
    }
    .text-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--ink);
        text-underline-offset: 0.3em;
        text-decoration-color: var(--rule-strong);
        transition:
            color var(--theme-transition),
            text-decoration-color var(--theme-transition);
    }
    .text-link:hover,
    .text-link:focus {
        color: var(--accent);
        text-decoration-color: var(--accent);
    }
    .content-section {
        width: 100%;
        max-width: 60rem;
        margin-inline: auto;
    }
    .section-label {
        margin-bottom: var(--space-6);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .content-section > .section-label {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }
    .content-section > .section-label::after {
        content: "";
        height: 1px;
        flex: 1;
        background: var(--rule);
    }
    .content-section h2 {
        max-width: 24ch;
    }
    .intro-copy {
        display: grid;
        gap: var(--space-6);
        margin-top: var(--space-8);
        font-size: var(--text-md);
    }
    .section-heading {
        margin-bottom: var(--space-12);
    }
    .timeline {
        display: grid;
        gap: 0;
        padding: 0;
        list-style: none;
    }
    .timeline li {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: var(--space-6);
        position: relative;
        padding-bottom: var(--space-12);
    }
    .timeline li:not(:last-child)::before {
        content: "";
        position: absolute;
        left: 0.45rem;
        top: 2rem;
        bottom: 0;
        width: 1px;
        background: var(--rule);
    }
    .timeline-marker {
        z-index: 1;
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--accent);
        color: var(--accent);
        background: var(--surface);
        font-family: var(--font-mono);
        font-size: 0.75rem;
    }
    .timeline h3,
    .projects h3 {
        margin-bottom: var(--space-2);
        font-size: var(--text-lg);
    }
    .timeline p,
    .projects p {
        max-width: 55ch;
    }
    .perspective {
        padding-block: var(--space-8);
    }
    .projects {
        display: grid;
        gap: 1px;
        margin-top: var(--space-12);
        background: var(--rule);
    }
    .projects article {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-6);
        background: var(--surface);
    }
    .projects article:first-child {
        padding-left: 0;
    }
    .projects article:last-child {
        padding-right: 0;
    }
    .project-meta {
        display: flex;
        justify-content: space-between;
        gap: var(--space-4);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .projects h3 {
        font-size: var(--text-lg);
    }
    .projects p {
        max-width: 48ch;
    }
    .projects .text-link {
        width: fit-content;
        margin-top: auto;
    }
    .closing-note {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-6);
    }
    .closing-note .section-label {
        grid-column: 1 / -1;
    }
    .closing-note p {
        max-width: 55ch;
        font-size: var(--text-lg);
        color: var(--ink);
    }
    .reveal {
        opacity: 0;
        transform: translateY(1rem);
        animation: reveal 700ms ease forwards;
    }
    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @media (min-width: 50em) {
        .page-content {
            gap: var(--space-24);
            padding-block: var(--space-24);
        }
        .hero-section {
            grid-template-columns: minmax(0, 1fr) 24rem;
            gap: var(--space-16);
            min-height: calc(100svh - 3.5rem - var(--space-24));
            align-content: center;
        }
        .hero-image {
            aspect-ratio: 4 / 5;
        }
        .intro-copy {
            grid-template-columns: 1fr 1fr;
            gap: var(--space-12);
        }
        .content-section h2 {
            font-size: clamp(2.25rem, 4.5vw, 3.5rem);
        }
        .content-section {
            display: flex;
            flex-direction: column;
            min-height: calc(100svh - 3.5rem - var(--space-12));
            justify-content: center;
        }
        .closing-note {
            display: grid;
            align-content: center;
        }
        .projects {
            grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr) minmax(0, 0.92fr);
        }
        .closing-note {
            grid-template-columns: 1fr auto;
            align-items: end;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .reveal {
            opacity: 1;
            transform: none;
            animation: none;
        }
        .portrait-frame::after,
        .hero-image {
            transition: none;
        }
    }
</style>
