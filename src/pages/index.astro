---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
    title="Sathiyaraman M | Solution Consultant & Engineer"
    description="Sathiyaraman M is a Solution Consultant and Engineer at Sahaj Software, working across technical consulting, software engineering, and platform engineering."
>
    <div class="page stack">
        <main id="home" class="wrapper stack page-content">
            <header class="hero-section reveal">
                <Hero
                    title="Hello, I’m Sathiyaraman."
                    tagline="I’m a Solution Consultant and Engineer at Sahaj Software. I work across consulting, software engineering, and platform engineering to make complex problems easier to solve."
                    align="start"
                >
                    <div class="hero-actions">
                        <CallToAction href="#about">
                            A little about me <Icon icon="arrow-right" size="1.1em" />
                        </CallToAction>
                    </div>
                </Hero>
                <div class="portrait-frame">
                    <img
                        class="hero-image"
                        alt="Sathiyaraman M"
                        width="480"
                        height="620"
                        src="/assets/portrait.jpeg"
                    />
                </div>
            </header>

            <section class="content-section intro reveal" id="about">
                <div class="section-label">01 / About</div>
                <h2>
                    I like understanding the whole problem before writing the
                    first line of code.
                </h2>
                <div class="intro-copy">
                    <p>
                        My work sits between people, systems, and code. I help
                        turn unclear problems into practical technical
                        direction, then stay close enough to the implementation
                        to make sure the solution works in the real world.
                    </p>
                    <p>
                        I bring a strong .NET and C# foundation from years of
                        building software, along with current experience in the
                        JVM ecosystem, TypeScript, Node.js, React, and platform
                        engineering. The technology matters, but choosing what
                        is useful, understandable, and maintainable matters
                        more.
                    </p>
                </div>
            </section>

            <section
                class="content-section timeline-section reveal"
                id="journey"
                aria-labelledby="journey-title"
            >
                <div class="section-label">02 / Journey</div>
                <div
                    class="section-heading"
                >
                    <h2 id="journey-title">
                        From building software to helping shape how it gets
                        built.
                    </h2>
                </div>
                <ol class="timeline">
                    <li>
                        <span class="timeline-marker">01</span>
                        <div>
                            <h3>A .NET foundation</h3>
                            <p>
                                My early years in software were shaped by .NET,
                                C#, ASP.NET Core, Blazor, and SQL Server. That
                                foundation is still a core part of how I think
                                and build.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="timeline-marker">02</span>
                        <div>
                            <h3>Learning by making</h3>
                            <p>
                                Projects, hackathons, and hands-on
                                experimentation taught me to connect technical
                                decisions with the people and problems behind
                                them.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="timeline-marker">03</span>
                        <div>
                            <h3>Consulting and engineering at Sahaj</h3>
                            <p>
                                For the past two years, I’ve worked across
                                technical consulting, decision-making,
                                implementation, and platform engineering.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="timeline-marker">04</span>
                        <div>
                            <h3>What I’m focused on now</h3>
                            <p>
                                Today, I work mostly with JVM technologies and
                                the TypeScript ecosystem, including Node.js and
                                React, while continuing to bring my .NET
                                experience to the problems I solve.
                            </p>
                        </div>
                    </li>
                </ol>
            </section>

            <section
                class="content-section perspective reveal"
                id="approach"
                aria-labelledby="perspective-title"
            >
                <div class="section-label">03 / Approach</div>
                <h2
                    id="perspective-title"
                >
                    Clear thinking, useful technology, and enough curiosity to
                    keep learning.
                </h2>
                <div class="principles">
                    <div>
                        <h3>Start with the problem</h3>
                        <p>
                            Good solutions begin with listening carefully and
                            understanding what success actually means.
                        </p>
                    </div>
                    <div>
                        <h3>Keep the system understandable</h3>
                        <p>
                            Complexity is sometimes necessary, but it should
                            never be the default or the selling point.
                        </p>
                    </div>
                    <div>
                        <h3>Stay close to the work</h3>
                        <p>
                            I enjoy the conversation around architecture just as
                            much as the craft of implementing it.
                        </p>
                    </div>
                </div>
            </section>

            <section class="content-section closing-note reveal">
                <div class="section-label">04 / Elsewhere</div>
                <p>
                    There is more to me than a list of technologies. I write
                    occasionally, keep learning, and make things when an idea is
                    interesting enough to follow.
                </p>
                <a
                    class="text-link"
                    href="https://blogs.sathiyaraman-m.com/"
                    target="_blank"
                    >Read what I write <Icon
                        icon="arrow-right"
                        size="1em"
                    />
                    </a>
            </section>
        </main>
        <div id="contact">
            <ContactCTA />
        </div>
    </div>
</BaseLayout>

<style>
    .page-content {
        gap: var(--space-24);
        padding-block: var(--space-16) var(--space-24);
    }
    .hero-section {
        display: grid;
        gap: var(--space-12);
        align-items: center;
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-6);
        margin-top: var(--space-8);
    }
    .portrait-frame {
        position: relative;
        width: min(100%, 25rem);
        border: 1px solid var(--rule-strong);
        background: var(--surface-raised);
    }
    .portrait-frame::after {
        content: "";
        position: absolute;
        inset: var(--space-3) calc(var(--space-3) * -1)
            calc(var(--space-3) * -1) var(--space-3);
        z-index: -1;
        border: 2px solid var(--accent);
        transition: transform 300ms ease;
    }
    .portrait-frame:hover::after {
        transform: translate(6px, 6px);
    }
    .hero-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        object-position: top;
        filter: saturate(0.85);
        transition:
            filter 300ms ease,
            transform 300ms ease;
    }
    .portrait-frame:hover .hero-image {
        filter: saturate(1);
        transform: translate(-4px, -4px);
    }
    .text-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--ink);
        text-underline-offset: 0.3em;
        text-decoration-color: var(--rule-strong);
        transition:
            color var(--theme-transition),
            text-decoration-color var(--theme-transition);
    }
    .text-link:hover,
    .text-link:focus {
        color: var(--accent);
        text-decoration-color: var(--accent);
    }
    .content-section {
        width: 100%;
        max-width: 52rem;
        margin-inline: auto;
    }
    .section-label {
        margin-bottom: var(--space-6);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .content-section > .section-label {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }
    .content-section > .section-label::after {
        content: "";
        height: 1px;
        flex: 1;
        background: var(--rule);
    }
    .content-section h2 {
        max-width: 24ch;
    }
    .intro-copy {
        display: grid;
        gap: var(--space-6);
        margin-top: var(--space-8);
        font-size: var(--text-md);
    }
    .timeline-section {
        max-width: 60rem;
    }
    .section-heading {
        margin-bottom: var(--space-12);
    }
    .timeline {
        display: grid;
        gap: 0;
        padding: 0;
        list-style: none;
    }
    .timeline li {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: var(--space-6);
        position: relative;
        padding-bottom: var(--space-12);
    }
    .timeline li:not(:last-child)::before {
        content: "";
        position: absolute;
        left: 0.45rem;
        top: 2rem;
        bottom: 0;
        width: 1px;
        background: var(--rule);
    }
    .timeline-marker {
        z-index: 1;
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--accent);
        color: var(--accent);
        background: var(--surface);
        font-family: var(--font-mono);
        font-size: 0.75rem;
    }
    .timeline h3,
    .principles h3 {
        margin-bottom: var(--space-2);
        font-size: var(--text-lg);
    }
    .timeline p,
    .principles p {
        max-width: 55ch;
    }
    .perspective {
        max-width: 60rem;
        padding-block: var(--space-8);
        border-block: 1px solid var(--rule);
    }
    .principles {
        display: grid;
        gap: var(--space-8);
        margin-top: var(--space-12);
    }
    .principles > div {
        padding-top: var(--space-4);
        border-top: 2px solid var(--accent);
    }
    .closing-note {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-6);
    }
    .closing-note .section-label {
        grid-column: 1 / -1;
    }
    .closing-note p {
        max-width: 55ch;
        font-size: var(--text-lg);
        color: var(--ink);
    }
    .reveal {
        opacity: 0;
        transform: translateY(1rem);
        animation: reveal 700ms ease forwards;
    }
    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @media (min-width: 50em) {
        .page-content {
            gap: var(--space-24);
            padding-block: var(--space-24);
        }
        .hero-section {
            grid-template-columns: minmax(0, 1fr) 24rem;
            gap: var(--space-16);
        }
        .hero-image {
            aspect-ratio: 4 / 5;
        }
        .intro-copy {
            grid-template-columns: 1fr 1fr;
            gap: var(--space-12);
        }
        .content-section h2 {
            font-size: clamp(2.5rem, 5vw, 4rem);
        }
        .principles {
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-8);
        }
        .closing-note {
            grid-template-columns: 1fr auto;
            align-items: end;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .reveal {
            opacity: 1;
            transform: none;
            animation: none;
        }
        .portrait-frame::after,
        .hero-image {
            transition: none;
        }
    }
</style>
